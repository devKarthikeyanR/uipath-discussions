<Activity mc:Ignorable="sap2010 sap" x:Class="Init_LoadConfig"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:s="clr-namespace:System;assembly=mscorlib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
 xmlns:sio="clr-namespace:System.IO;assembly=mscorlib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Init_LoadConfig.xaml
    ---------------------------------------------------------------
    PURPOSE
    Reads ApplicationConfig.xlsx (primary), structurally validates it,
    falls back to a Last-Known-Good cached copy if the primary is
    missing/corrupt/invalid, and on a successful PRIMARY read refreshes
    the LKG cache. Never throws past this workflow - all failure states
    are reported via out_ConfigLoadSuccess / out_ConfigErrorMessage so
    Main.xaml can decide whether to abort gracefully.

    IN ARGUMENTS
      in_ConfigFilePath   (String)  Primary Excel path (SharePoint/network)
      in_LkgCachePath     (String)  Local Last-Known-Good cache path
      in_ProjectDirectory (String)  Project root, used to verify that every
                                    Operation referenced in a scenario sheet
                                    has a matching AppLibraries xaml on disk

    OUT ARGUMENTS
      out_ConfigLoadSuccess (Boolean)
      out_ConfigSource      (String)  "Primary" | "LastKnownGood" | "None"
      out_ConfigErrorMessage(String)  Diagnostic detail, always populated
                                       on partial/full failure
      out_dtApplications    (DataTable)  ApplicationConfig sheet contents
      out_ScenarioTables    (Dictionary<String, DataTable>)
                                       Key = AppName, Value = that app's
                                       scenario sheet, ONLY for rows where
                                       VerifyYN = "Yes"
  -->

  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Collections.Generic</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>

  <x:Members>
    <x:Property Name="in_ConfigFilePath" Type="InArgument(x:String)" />
    <x:Property Name="in_LkgCachePath" Type="InArgument(x:String)" />
    <x:Property Name="in_ProjectDirectory" Type="InArgument(x:String)" />
    <x:Property Name="out_ConfigLoadSuccess" Type="OutArgument(x:Boolean)" />
    <x:Property Name="out_ConfigSource" Type="OutArgument(x:String)" />
    <x:Property Name="out_ConfigErrorMessage" Type="OutArgument(x:String)" />
    <x:Property Name="out_dtApplications" Type="OutArgument(sd:DataTable)" />
    <x:Property Name="out_ScenarioTables" Type="OutArgument(scg:Dictionary(x:String, sd:DataTable))" />
  </x:Members>

  <sap2010:WorkflowViewState.IdRef>Init_LoadConfig_1</sap2010:WorkflowViewState.IdRef>

  <Sequence DisplayName="Init_LoadConfig" sap2010:WorkflowViewState.IdRef="Sequence_Root">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" Default="False" Name="primarySuccess" />
      <Variable x:TypeArguments="x:Boolean" Default="False" Name="lkgSuccess" />
      <Variable x:TypeArguments="x:String" Default="&quot;&quot;" Name="errMsg" />
      <Variable x:TypeArguments="x:String" Default="&quot;&quot;" Name="validationMsg" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtApplications" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtScenarioTemp" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" Name="scenarioTables">
        <Variable.Default>
          <scg:Dictionary x:TypeArguments="x:String, sd:DataTable" />
        </Variable.Default>
      </Variable>
      <Variable x:TypeArguments="sd:DataRow" Name="appRow" />
      <Variable x:TypeArguments="s:Exception" Name="lkgEx" />
    </Sequence.Variables>

    <!-- =========================================================
         STAGE 1: Attempt PRIMARY config load + validation
         ========================================================= -->
    <TryCatch DisplayName="Try Load Primary Config" sap2010:WorkflowViewState.IdRef="TryCatch_Primary">
      <TryCatch.Try>
        <Sequence DisplayName="Read + Validate Primary" sap2010:WorkflowViewState.IdRef="Sequence_PrimaryTry">

          <ui:ReadRange DisplayName="Read ApplicationConfig Sheet"
                         sap2010:WorkflowViewState.IdRef="ReadRange_AppConfig_Primary"
                         AddHeaders="True"
                         SheetName="[&quot;ApplicationConfig&quot;]"
                         WorkbookPath="[in_ConfigFilePath]"
                         DataTable="[dtApplications]" />

          <!-- Structural validation: required columns present -->
          <If Condition="[Not (dtApplications IsNot Nothing AndAlso dtApplications.Columns.Contains(&quot;AppID&quot;) AndAlso dtApplications.Columns.Contains(&quot;AppName&quot;) AndAlso dtApplications.Columns.Contains(&quot;ExePath&quot;) AndAlso dtApplications.Columns.Contains(&quot;VerifyYN&quot;) AndAlso dtApplications.Columns.Contains(&quot;Priority&quot;) AndAlso dtApplications.Columns.Contains(&quot;TimeoutSec&quot;))]"
              DisplayName="Missing Required Columns?"
              sap2010:WorkflowViewState.IdRef="If_ColumnsMissing">
            <If.Then>
              <Throw Exception="[New ApplicationException(&quot;ApplicationConfig sheet is missing one or more required columns (AppID, AppName, ExePath, VerifyYN, Priority, TimeoutSec).&quot;)]"
                     DisplayName="Throw Missing Columns"
                     sap2010:WorkflowViewState.IdRef="Throw_ColumnsMissing" />
            </If.Then>
          </If>

          <!-- Per-app validation: for every row marked VerifyYN=Yes, confirm a
               matching scenario sheet exists AND every enabled Operation in it
               has a matching AppLibraries xaml on disk. Read each into the
               scenarioTables dictionary as we go. -->
          <ForEach x:TypeArguments="sd:DataRow"
                   DisplayName="For Each App Marked VerifyYN=Yes"
                   sap2010:WorkflowViewState.IdRef="ForEach_Apps"
                   Values="[dtApplications.Select(&quot;VerifyYN = 'Yes'&quot;)]">
            <ActivityAction x:TypeArguments="sd:DataRow">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="sd:DataRow" Name="appRow" />
              </ActivityAction.Argument>

              <Sequence DisplayName="Load + Validate One App's Scenario Sheet"
                        sap2010:WorkflowViewState.IdRef="Sequence_PerApp">
                <Sequence.Variables>
                  <Variable x:TypeArguments="x:String" Name="sheetName" />
                  <Variable x:TypeArguments="x:String" Name="appLibFolder" />
                </Sequence.Variables>

                <Assign DisplayName="Build Scenario Sheet Name" sap2010:WorkflowViewState.IdRef="Assign_SheetName">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[sheetName]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[appRow("AppName").ToString.Trim + "_Scenarios"]</InArgument>
                  </Assign.Value>
                </Assign>

                <ui:ReadRange DisplayName="Read App's Scenario Sheet"
                               sap2010:WorkflowViewState.IdRef="ReadRange_Scenario_Primary"
                               AddHeaders="True"
                               SheetName="[sheetName]"
                               WorkbookPath="[in_ConfigFilePath]"
                               DataTable="[dtScenarioTemp]" />

                <If Condition="[Not (dtScenarioTemp IsNot Nothing AndAlso dtScenarioTemp.Columns.Contains(&quot;ScenarioID&quot;) AndAlso dtScenarioTemp.Columns.Contains(&quot;Operation&quot;) AndAlso dtScenarioTemp.Columns.Contains(&quot;InputParamsJSON&quot;) AndAlso dtScenarioTemp.Columns.Contains(&quot;Enabled&quot;) AndAlso dtScenarioTemp.Columns.Contains(&quot;RunOrder&quot;))]"
                    DisplayName="Missing Required Scenario Columns?"
                    sap2010:WorkflowViewState.IdRef="If_ScenarioColumnsMissing">
                  <If.Then>
                    <Throw Exception="[New ApplicationException(&quot;Sheet &apos;&quot; + sheetName + &quot;&apos; is missing one or more required columns (ScenarioID, Operation, InputParamsJSON, Enabled, RunOrder).&quot;)]"
                           DisplayName="Throw Missing Scenario Columns"
                           sap2010:WorkflowViewState.IdRef="Throw_ScenarioColumnsMissing" />
                  </If.Then>
                </If>

                <!-- Confirm every ENABLED operation has a matching AppLibraries xaml -->
                <Assign DisplayName="Build App Library Folder Path" sap2010:WorkflowViewState.IdRef="Assign_AppLibFolder">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[appLibFolder]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[Path.Combine(in_ProjectDirectory, "AppLibraries", appRow("AppName").ToString.Trim)]</InArgument>
                  </Assign.Value>
                </Assign>

                <ForEach x:TypeArguments="sd:DataRow"
                         DisplayName="For Each Enabled Scenario Row"
                         sap2010:WorkflowViewState.IdRef="ForEach_ScenarioRows"
                         Values="[dtScenarioTemp.Select(&quot;Enabled = 'Yes'&quot;)]">
                  <ActivityAction x:TypeArguments="sd:DataRow">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="sd:DataRow" Name="scenarioRow" />
                    </ActivityAction.Argument>

                    <If Condition="[Not File.Exists(Path.Combine(appLibFolder, appRow(&quot;AppName&quot;).ToString.Trim + &quot;_&quot; + scenarioRow(&quot;Operation&quot;).ToString.Trim + &quot;.xaml&quot;))]"
                        DisplayName="Operation Workflow Missing On Disk?"
                        sap2010:WorkflowViewState.IdRef="If_OperationXamlMissing">
                      <If.Then>
                        <Throw Exception="[New ApplicationException(&quot;No matching operation workflow found for App=&quot; + appRow(&quot;AppName&quot;).ToString + &quot;, Operation=&quot; + scenarioRow(&quot;Operation&quot;).ToString + &quot; (Scenario &quot; + scenarioRow(&quot;ScenarioID&quot;).ToString + &quot;). Expected file: &quot; + Path.Combine(appLibFolder, appRow(&quot;AppName&quot;).ToString.Trim + &quot;_&quot; + scenarioRow(&quot;Operation&quot;).ToString.Trim + &quot;.xaml&quot;))]"
                               DisplayName="Throw Operation Xaml Missing"
                               sap2010:WorkflowViewState.IdRef="Throw_OperationXamlMissing" />
                      </If.Then>
                    </If>
                  </ActivityAction>
                </ForEach>

                <Assign DisplayName="Store Scenario Table In Dictionary" sap2010:WorkflowViewState.IdRef="Assign_StoreScenarioTable">
                  <Assign.To>
                    <OutArgument x:TypeArguments="sd:DataTable">[scenarioTables(appRow("AppName").ToString.Trim)]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="sd:DataTable">[dtScenarioTemp.Copy]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </ActivityAction>
          </ForEach>

          <Assign DisplayName="Mark Primary Success" sap2010:WorkflowViewState.IdRef="Assign_PrimarySuccessTrue">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[primarySuccess]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">True</InArgument>
            </Assign.Value>
          </Assign>

        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Primary">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="primaryEx" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Record Primary Failure" sap2010:WorkflowViewState.IdRef="Sequence_CatchPrimary">
              <Assign DisplayName="Append Error Message" sap2010:WorkflowViewState.IdRef="Assign_ErrMsgPrimary">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[errMsg]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">["Primary config load/validation failed: " + primaryEx.Message]</InArgument>
                </Assign.Value>
              </Assign>
              <ui:LogMessage DisplayName="Log Primary Failure"
                             sap2010:WorkflowViewState.IdRef="LogMessage_PrimaryFail"
                             Level="Warn"
                             Message="[errMsg]" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <!-- =========================================================
         STAGE 2: If primary failed, attempt Last-Known-Good cache
         ========================================================= -->
    <If Condition="[Not primarySuccess]" DisplayName="Primary Failed - Try LKG?" sap2010:WorkflowViewState.IdRef="If_TryLkg">
      <If.Then>
        <TryCatch DisplayName="Try Load LKG Cache" sap2010:WorkflowViewState.IdRef="TryCatch_Lkg">
          <TryCatch.Try>
            <Sequence DisplayName="Read + Validate LKG" sap2010:WorkflowViewState.IdRef="Sequence_LkgTry">

              <If Condition="[Not File.Exists(in_LkgCachePath)]"
                  DisplayName="LKG File Missing?"
                  sap2010:WorkflowViewState.IdRef="If_LkgMissing">
                <If.Then>
                  <Throw Exception="[New ApplicationException(&quot;No Last-Known-Good cache file found at: &quot; + in_LkgCachePath)]"
                         DisplayName="Throw LKG Missing"
                         sap2010:WorkflowViewState.IdRef="Throw_LkgMissing" />
                </If.Then>
              </If>

              <ui:ReadRange DisplayName="Read ApplicationConfig Sheet (LKG)"
                             sap2010:WorkflowViewState.IdRef="ReadRange_AppConfig_Lkg"
                             AddHeaders="True"
                             SheetName="[&quot;ApplicationConfig&quot;]"
                             WorkbookPath="[in_LkgCachePath]"
                             DataTable="[dtApplications]" />

              <If Condition="[Not (dtApplications IsNot Nothing AndAlso dtApplications.Columns.Contains(&quot;AppID&quot;) AndAlso dtApplications.Columns.Contains(&quot;AppName&quot;) AndAlso dtApplications.Columns.Contains(&quot;VerifyYN&quot;))]"
                  DisplayName="LKG Missing Required Columns?"
                  sap2010:WorkflowViewState.IdRef="If_LkgColumnsMissing">
                <If.Then>
                  <Throw Exception="[New ApplicationException(&quot;LKG cache ApplicationConfig sheet is missing required columns.&quot;)]"
                         DisplayName="Throw LKG Columns Missing"
                         sap2010:WorkflowViewState.IdRef="Throw_LkgColumnsMissing" />
                </If.Then>
              </If>

              <!-- NOTE: for brevity, the same per-app scenario-sheet read/validate
                   loop used in Stage 1 should be duplicated here against
                   in_LkgCachePath, populating scenarioTables identically.
                   Extract that loop into a shared Invoked workflow
                   (e.g. "ReadAndValidateAllScenarios.xaml" taking WorkbookPath
                   as an argument) to avoid maintaining the same logic twice. -->
              <InvokeWorkflowFile DisplayName="Read + Validate All Scenario Sheets (LKG)"
                                   sap2010:WorkflowViewState.IdRef="Invoke_ReadScenariosLkg"
                                   WorkflowFileName="[Path.Combine(in_ProjectDirectory, &quot;Framework&quot;, &quot;ReadAndValidateAllScenarios.xaml&quot;)]">
                <InvokeWorkflowFile.Arguments>
                  <InArgument x:TypeArguments="x:String" x:Key="in_WorkbookPath">[in_LkgCachePath]</InArgument>
                  <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtApplications">[dtApplications]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_ProjectDirectory">[in_ProjectDirectory]</InArgument>
                  <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)" x:Key="out_ScenarioTables">[scenarioTables]</OutArgument>
                </InvokeWorkflowFile.Arguments>
              </InvokeWorkflowFile>

              <Assign DisplayName="Mark LKG Success" sap2010:WorkflowViewState.IdRef="Assign_LkgSuccessTrue">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Boolean">[lkgSuccess]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Boolean">True</InArgument>
                </Assign.Value>
              </Assign>

            </Sequence>
          </TryCatch.Try>
          <TryCatch.Catches>
            <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Lkg">
              <ActivityAction x:TypeArguments="s:Exception">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="s:Exception" Name="lkgCatchEx" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Record LKG Failure" sap2010:WorkflowViewState.IdRef="Sequence_CatchLkg">
                  <Assign DisplayName="Append LKG Error" sap2010:WorkflowViewState.IdRef="Assign_ErrMsgLkg">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[errMsg]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[errMsg + " | LKG load/validation also failed: " + lkgCatchEx.Message]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:LogMessage DisplayName="Log LKG Failure"
                                 sap2010:WorkflowViewState.IdRef="LogMessage_LkgFail"
                                 Level="Error"
                                 Message="[errMsg]" />
                </Sequence>
              </ActivityAction>
            </Catch>
          </TryCatch.Catches>
        </TryCatch>
      </If.Then>
    </If>

    <!-- =========================================================
         STAGE 3: If primary succeeded, refresh the LKG cache
         (best-effort - never fails the overall Init step)
         ========================================================= -->
    <If Condition="[primarySuccess]" DisplayName="Primary Succeeded - Refresh LKG Cache" sap2010:WorkflowViewState.IdRef="If_RefreshLkg">
      <If.Then>
        <TryCatch DisplayName="Try Refresh LKG (Best Effort)" sap2010:WorkflowViewState.IdRef="TryCatch_RefreshLkg">
          <TryCatch.Try>
            <InvokeMethod DisplayName="Ensure LKG Directory Exists"
                           sap2010:WorkflowViewState.IdRef="InvokeMethod_EnsureDir"
                           MethodName="CreateDirectory"
                           TargetType="sio:Directory">
              <InArgument x:TypeArguments="x:String">[Path.GetDirectoryName(in_LkgCachePath)]</InArgument>
            </InvokeMethod>
            <InvokeMethod DisplayName="Copy Primary Over LKG Cache"
                           sap2010:WorkflowViewState.IdRef="InvokeMethod_CopyLkg"
                           MethodName="Copy"
                           TargetType="sio:File">
              <InArgument x:TypeArguments="x:String">[in_ConfigFilePath]</InArgument>
              <InArgument x:TypeArguments="x:String">[in_LkgCachePath]</InArgument>
              <InArgument x:TypeArguments="x:Boolean">True</InArgument>
            </InvokeMethod>
          </TryCatch.Try>
          <TryCatch.Catches>
            <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_RefreshLkg">
              <ActivityAction x:TypeArguments="s:Exception">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="s:Exception" Name="refreshEx" />
                </ActivityAction.Argument>
                <ui:LogMessage DisplayName="Log LKG Refresh Failure (non-fatal)"
                               sap2010:WorkflowViewState.IdRef="LogMessage_RefreshLkgFail"
                               Level="Warn"
                               Message="[&quot;Could not refresh LKG cache (non-fatal): &quot; + refreshEx.Message]" />
              </ActivityAction>
            </Catch>
          </TryCatch.Catches>
        </TryCatch>
      </If.Then>
    </If>

    <!-- =========================================================
         STAGE 4: Populate final out arguments
         ========================================================= -->
    <Assign DisplayName="Set out_ConfigLoadSuccess" sap2010:WorkflowViewState.IdRef="Assign_OutSuccess">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[out_ConfigLoadSuccess]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[primarySuccess Or lkgSuccess]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set out_ConfigSource" sap2010:WorkflowViewState.IdRef="Assign_OutSource">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_ConfigSource]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(primarySuccess, "Primary", If(lkgSuccess, "LastKnownGood", "None"))]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set out_ConfigErrorMessage" sap2010:WorkflowViewState.IdRef="Assign_OutErrMsg">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_ConfigErrorMessage]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[errMsg]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set out_dtApplications" sap2010:WorkflowViewState.IdRef="Assign_OutDtApplications">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[out_dtApplications]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[dtApplications]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set out_ScenarioTables" sap2010:WorkflowViewState.IdRef="Assign_OutScenarioTables">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)">[out_ScenarioTables]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)">[scenarioTables]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log Final Init Result"
                   sap2010:WorkflowViewState.IdRef="LogMessage_Final"
                   Level="[If(out_ConfigLoadSuccess, LogLevel.Info, LogLevel.Fatal)]"
                   Message="[&quot;Init_LoadConfig complete. Success=&quot; + out_ConfigLoadSuccess.ToString + &quot;, Source=&quot; + out_ConfigSource + &quot;, Detail=&quot; + out_ConfigErrorMessage]" />

  </Sequence>
</Activity>
