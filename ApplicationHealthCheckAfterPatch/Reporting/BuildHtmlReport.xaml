<Activity mc:Ignorable="sap sap2010" x:Class="Reporting_BuildHtmlReport" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="Application ID (e.g. APP001)." Name="in_AppID" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Application name (e.g. Outlook)." Name="in_AppName" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Overall app status: PASS or FAIL." Name="in_AppStatus" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="RunID for this health check run." Name="in_RunID" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Every scenario's result: columns ScenarioID, ScenarioName, Operation, Status, Details." Name="in_ScenarioResults" Type="InArgument(sd:DataTable)" />
    <x:Property sap2010:Annotation.AnnotationText="Path to Templates\HolisticReportTemplate.html." Name="in_TemplatePath" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="The rendered HTML report body." Name="out_HtmlBody" Type="OutArgument(x:String)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>C#</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>GlobalConstantsNamespace</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Build Holistic HTML Report">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="TemplateText" />
      <Variable x:TypeArguments="x:String" Name="RowsHtml" />
      <Variable x:TypeArguments="x:String" Name="RowHtml" />
      <Variable x:TypeArguments="x:Int32" Name="PassCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="FailCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="TotalCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="PassRate" Default="0" />
    </Sequence.Variables>
    <Assign DisplayName="Initialize RowsHtml">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">RowsHtml</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">""</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:ReadTextFile DisplayName="Read Text File (report template)" Encoding="{x:Null}">
      <ui:ReadTextFile.FileName>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">in_TemplatePath</CSharpValue>
        </InArgument>
      </ui:ReadTextFile.FileName>
      <ui:ReadTextFile.Content>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">TemplateText</CSharpReference>
        </OutArgument>
      </ui:ReadTextFile.Content>
    </ui:ReadTextFile>
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DisplayName="For each scenario result">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="Row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <Assign DisplayName="Assign TotalCount">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">
                  <CSharpReference x:TypeArguments="x:Int32">TotalCount</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">
                  <CSharpValue x:TypeArguments="x:Int32">TotalCount + 1</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="If scenario passed">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">
                  <CSharpValue x:TypeArguments="x:Boolean">Row["Status"].ToString() == "Pass"</CSharpValue>
                </InArgument>
              </If.Condition>
              <If.Then>
                <Assign DisplayName="Assign PassCount">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Int32">
                      <CSharpReference x:TypeArguments="x:Int32">PassCount</CSharpReference>
                    </OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Int32">
                      <CSharpValue x:TypeArguments="x:Int32">PassCount + 1</CSharpValue>
                    </InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
              <If.Else>
                <Assign DisplayName="Assign FailCount">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Int32">
                      <CSharpReference x:TypeArguments="x:Int32">FailCount</CSharpReference>
                    </OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Int32">
                      <CSharpValue x:TypeArguments="x:Int32">FailCount + 1</CSharpValue>
                    </InArgument>
                  </Assign.Value>
                </Assign>
              </If.Else>
            </If>
            <Assign DisplayName="Assign RowHtml">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">RowHtml</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">"&lt;tr data-status=\"" + (Row["Status"].ToString() == "Pass" ? "pass" : "fail") + "\" class=\"hover:bg-gray-50 transition-colors\" title=\"" + Row["Details"].ToString().Replace("\"", "&amp;quot;") + "\"&gt;&lt;td class=\"text-center text-gray-500 w-12\"&gt;" + (TotalCount).ToString() + "&lt;/td&gt;&lt;td&gt;" + Row["ScenarioID"].ToString() + "&lt;/td&gt;&lt;td&gt;" + Row["ScenarioName"].ToString() + "&lt;/td&gt;&lt;td&gt;" + Row["Operation"].ToString() + "&lt;/td&gt;&lt;td&gt;&lt;span class=\"pill " + (Row["Status"].ToString() == "Pass" ? "pill-pass" : "pill-fail") + "\"&gt;" + Row["Status"].ToString().ToUpper() + "&lt;/span&gt;&lt;/td&gt;&lt;td&gt;" + Row["Details"].ToString() + "&lt;/td&gt;&lt;/tr&gt;"</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Append RowHtml to RowsHtml">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">RowsHtml</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">RowsHtml + RowHtml</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
      <ui:ForEachRow.DataTable>
        <InArgument x:TypeArguments="sd:DataTable">
          <CSharpValue x:TypeArguments="sd:DataTable">in_ScenarioResults</CSharpValue>
        </InArgument>
      </ui:ForEachRow.DataTable>
    </ui:ForEachRow>
    <Assign DisplayName="Assign PassRate">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">
          <CSharpReference x:TypeArguments="x:Int32">PassRate</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">
          <CSharpValue x:TypeArguments="x:Int32">TotalCount == 0 ? 0 : (int)Math.Round(100.0 * PassCount / TotalCount)</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign out_HtmlBody (template substitution)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">out_HtmlBody</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">TemplateText.Replace("{{APP_NAME}}", in_AppName).Replace("{{APP_ID}}", in_AppID).Replace("{{RUN_ID}}", in_RunID).Replace("{{TIMESTAMP}}", DateTime.Now.ToString()).Replace("{{APP_STATUS}}", in_AppStatus).Replace("{{APP_STATUS_TEXT_CLASS}}", in_AppStatus == "PASS" ? "text-green-700" : "text-red-700").Replace("{{DONUT_COLOR_CLASS}}", "text-green-500").Replace("{{DONUT_DASHARRAY}}", PassRate.ToString() + " " + (100 - PassRate).ToString()).Replace("{{PASS_RATE}}", PassRate.ToString()).Replace("{{PASS_COUNT}}", PassCount.ToString()).Replace("{{FAIL_COUNT}}", FailCount.ToString()).Replace("{{TOTAL_COUNT}}", TotalCount.ToString()).Replace("{{SCENARIO_ROWS}}", RowsHtml)</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
