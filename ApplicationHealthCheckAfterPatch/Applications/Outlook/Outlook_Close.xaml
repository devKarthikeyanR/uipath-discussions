  <Sequence DisplayName="Outlook Close" sap2010:Annotation.AnnotationText="Attaches to the running Outlook Classic instance and closes it gracefully. TargetApp attach selector is a placeholder — a developer must run Indicate against a real Outlook Classic window.">
    <ui:LogMessage DisplayName="Log Message (Outlook close requested)" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Closing Outlook Classic gracefully."</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <uix:NApplicationCard DisplayName="TODO Indicate — Use Application/Browser (attach Outlook Classic to close)" AttachMode="ByInstance" OpenMode="Never" CloseMode="Always" HealingAgentBehavior="Job" IsDisplayNameAuto="False" ScopeGuid="c1a1e001-0001-4a11-8a11-0000000000a2" Version="V2">
