  <Sequence DisplayName="Outlook Send Email" sap2010:Annotation.AnnotationText="Composes and sends a plain email via Outlook Classic. All Click/Type Into targets are placeholders — a developer must run Indicate against a real Outlook Classic instance on each TODO-marked activity (New Email button, To/Subject/Body fields, Send button).">
    <uix:NApplicationCard DisplayName="TODO Indicate — Use Application/Browser (attach Outlook Classic)" AttachMode="ByInstance" OpenMode="Never" CloseMode="Never" HealingAgentBehavior="Job" IsDisplayNameAuto="False" ScopeGuid="c1a1e001-0001-4a11-8a11-0000000000b1" Version="V2">
      <uix:NApplicationCard.Timeout>
        <InArgument x:TypeArguments="x:Double">
          <CSharpValue x:TypeArguments="x:Double">(double)in_TimeoutSec</CSharpValue>
        </InArgument>
      </uix:NApplicationCard.Timeout>
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do">
            <ui:LogMessage DisplayName="Log Message (composing email)" Level="Info">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object">
                  <CSharpValue x:TypeArguments="x:Object">"Composing email to " + in_TargetRecipient + " — subject: " + in_Subject</CSharpValue>
                </InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
            <uix:NClick DisplayName="TODO Indicate — Click New Email button" ActivateBefore="True" ClickType="Single" HealingAgentBehavior="SameAsCard" KeyModifiers="None" MouseButton="Left" Version="V5" />
            <uix:NTypeInto DisplayName="TODO Indicate — Type To recipient" ActivateBefore="True" ClickBeforeMode="Single" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" Version="V5">
              <uix:NTypeInto.Text>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">in_TargetRecipient</CSharpValue>
                </InArgument>
              </uix:NTypeInto.Text>
            </uix:NTypeInto>
            <uix:NTypeInto DisplayName="TODO Indicate — Type Subject" ActivateBefore="True" ClickBeforeMode="Single" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" Version="V5">
              <uix:NTypeInto.Text>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">in_Subject</CSharpValue>
                </InArgument>
              </uix:NTypeInto.Text>
            </uix:NTypeInto>
            <uix:NTypeInto DisplayName="TODO Indicate — Type Body" ActivateBefore="True" ClickBeforeMode="Single" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" Version="V5">
              <uix:NTypeInto.Text>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">in_Body</CSharpValue>
                </InArgument>
              </uix:NTypeInto.Text>
            </uix:NTypeInto>
            <uix:NClick DisplayName="TODO Indicate — Click Send button" ActivateBefore="True" ClickType="Single" HealingAgentBehavior="SameAsCard" KeyModifiers="None" MouseButton="Left" Version="V5" />
            <ui:LogMessage DisplayName="Log Message (email sent)" Level="Info">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object">
                  <CSharpValue x:TypeArguments="x:Object">"Send Email scenario completed for subject: " + in_Subject</CSharpValue>
                </InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.TargetApp>
        <uix:TargetApp Area="0, 0, 0, 0" Version="V3" />
