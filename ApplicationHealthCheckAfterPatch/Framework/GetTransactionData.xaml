  <Sequence sap2010:Annotation.AnnotationText="Get a transaction item from a specified source (e.g., Orchestrator queues, spreadsheets, databases, mailboxes or web APIs). &#xA;&#xA;If there are no transaction items remaining, out_TransactionItem is set to Nothing, which leads to the End Process state. &#xA;&#xA;For cases in which there is only a single transaction (i.e., a linear process), use an If activity to check whether the argument in_TransactionNumber has the value 1 (meaning it is the first and only transaction) and assign the transaction item to out_TransactionItem. For any other value of in_TransactionNumber, out_TransactionItem should be set to Nothing.&#xA;&#xA;If there are multiple transactions, use the argument in_TransactionNumber as an index to retrieve the correct transaction to be processed. If there are no more transactions left, it is necessary to set out_TransactionItem to Nothing, thus ending the process." DisplayName="Get Transaction Data" sap:VirtualizedContainerService.HintSize="1422,1987.2" sap2010:WorkflowViewState.IdRef="Sequence_3">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataRow" Name="CurrentAppRow" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log Message Get Transaction Item" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Get the next application row"</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <If sap2010:Annotation.AnnotationText="On the first call, read the Applications sheet from the Health Check config workbook and keep only Enabled=Y rows." DisplayName="If first transaction, load Applications sheet">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <CSharpValue x:TypeArguments="x:Boolean">in_TransactionNumber == 1</CSharpValue>
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Load Applications sheet">
          <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DisplayName="Read range (Applications sheet)" SheetName="Applications">
            <ui:ReadRange.DataTable>
              <OutArgument x:TypeArguments="sd:DataTable">
                <CSharpReference x:TypeArguments="sd:DataTable">io_dt_TransactionData</CSharpReference>
              </OutArgument>
            </ui:ReadRange.DataTable>
            <ui:ReadRange.WorkbookPath>
              <InArgument x:TypeArguments="x:String">
                <CSharpValue x:TypeArguments="x:String">in_Config["AppConfigWorkbook"].ToString()</CSharpValue>
              </InArgument>
            </ui:ReadRange.WorkbookPath>
          </ui:ReadRange>
          <Assign DisplayName="Assign io_dt_TransactionData (Enabled rows only)">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataTable">
                <CSharpReference x:TypeArguments="sd:DataTable">io_dt_TransactionData</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataTable">
                <CSharpValue x:TypeArguments="sd:DataTable">io_dt_TransactionData.AsEnumerable().Where(r =&gt; r.Field&lt;string&gt;("Enabled") != null &amp;&amp; r.Field&lt;string&gt;("Enabled").Trim().ToUpper() == "Y").Any() ? io_dt_TransactionData.AsEnumerable().Where(r =&gt; r.Field&lt;string&gt;("Enabled") != null &amp;&amp; r.Field&lt;string&gt;("Enabled").Trim().ToUpper() == "Y").CopyToDataTable() : io_dt_TransactionData.Clone()</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
    <If sap2010:Annotation.AnnotationText="No more enabled application rows to process." DisplayName="If no more application rows">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <CSharpValue x:TypeArguments="x:Boolean">in_TransactionNumber &gt; io_dt_TransactionData.Rows.Count</CSharpValue>
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then">
          <Assign DisplayName="Assign out_TransactionItem (null)">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Object">
                <CSharpReference x:TypeArguments="x:Object">out_TransactionItem</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">null</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else">
          <Assign DisplayName="Assign CurrentAppRow">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">
                <CSharpReference x:TypeArguments="sd:DataRow">CurrentAppRow</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">
                <CSharpValue x:TypeArguments="sd:DataRow">io_dt_TransactionData.Rows[in_TransactionNumber - 1]</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign out_TransactionItem">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Object">
                <CSharpReference x:TypeArguments="x:Object">out_TransactionItem</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">CurrentAppRow</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign out_TransactionID">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <CSharpReference x:TypeArguments="x:String">out_TransactionID</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <CSharpValue x:TypeArguments="x:String">CurrentAppRow["AppID"].ToString()</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign out_TransactionField1 (AppName)">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <CSharpReference x:TypeArguments="x:String">out_TransactionField1</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <CSharpValue x:TypeArguments="x:String">CurrentAppRow["AppName"].ToString()</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign out_TransactionField2 (ExePath)">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <CSharpReference x:TypeArguments="x:String">out_TransactionField2</CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <CSharpValue x:TypeArguments="x:String">CurrentAppRow["ExePath"].ToString()</CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log Message (application row retrieved)" Level="Info">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">"Retrieved application transaction: " + out_TransactionID + " (" + out_TransactionField1 + ")"</CSharpValue>
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
