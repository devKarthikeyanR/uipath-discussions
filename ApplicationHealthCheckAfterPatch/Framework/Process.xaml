    <ui:LogMessage DisplayName="Log Message (starting app health check)" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Starting health check for " + AppName + " (" + AppID + ")"</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <TryCatch DisplayName="Try process this application">
      <TryCatch.Try>
        <Sequence DisplayName="Try">
          <Switch x:TypeArguments="x:String" DisplayName="Switch on AppName" Expression="AppName">
            <Sequence x:Key="Outlook" DisplayName="Outlook">
              <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Outlook_Launch workflow" UnSafe="False" WorkflowFileName="Applications\Outlook\Outlook_Launch.xaml">
                <ui:InvokeWorkflowFile.Arguments>
                  <scg:Dictionary x:TypeArguments="x:String, Argument">
                    <InArgument x:TypeArguments="x:String" x:Key="in_ExePath">
                      <CSharpValue x:TypeArguments="x:String">ExePath</CSharpValue>
                    </InArgument>
                    <InArgument x:TypeArguments="x:Int32" x:Key="in_TimeoutSec">
                      <CSharpValue x:TypeArguments="x:Int32">TimeoutSec</CSharpValue>
                    </InArgument>
                  </scg:Dictionary>
                </ui:InvokeWorkflowFile.Arguments>
              </ui:InvokeWorkflowFile>
              <Assign DisplayName="Assign AppLaunched">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Boolean">
                    <CSharpReference x:TypeArguments="x:Boolean">AppLaunched</CSharpReference>
                  </OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Boolean">
                    <CSharpValue x:TypeArguments="x:Boolean">true</CSharpValue>
                  </InArgument>
                </Assign.Value>
              </Assign>
              <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DisplayName="Read range (TC_&lt;AppName&gt; sheet)">
                <ui:ReadRange.DataTable>
                  <OutArgument x:TypeArguments="sd:DataTable">
                    <CSharpReference x:TypeArguments="sd:DataTable">dtScenarios</CSharpReference>
                  </OutArgument>
                </ui:ReadRange.DataTable>
                <ui:ReadRange.SheetName>
                  <InArgument x:TypeArguments="x:String">
                    <CSharpValue x:TypeArguments="x:String">"TC_" + AppName</CSharpValue>
                  </InArgument>
                </ui:ReadRange.SheetName>
                <ui:ReadRange.WorkbookPath>
                  <InArgument x:TypeArguments="x:String">
                    <CSharpValue x:TypeArguments="x:String">AppConfigWorkbook</CSharpValue>
                  </InArgument>
                </ui:ReadRange.WorkbookPath>
              </ui:ReadRange>
              <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DisplayName="For each scenario row">
                <ui:ForEachRow.Body>
                  <ActivityAction x:TypeArguments="sd:DataRow">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="sd:DataRow" Name="ScenarioRow" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Body">
                      <If DisplayName="If scenario is enabled">
                        <If.Condition>
                          <InArgument x:TypeArguments="x:Boolean">
                            <CSharpValue x:TypeArguments="x:Boolean">ScenarioRow["Enabled"].ToString().Trim().ToUpper() == "Y"</CSharpValue>
                          </InArgument>
                        </If.Condition>
                        <If.Then>
                          <Sequence DisplayName="Then">
                            <Sequence.Variables>
                              <Variable x:TypeArguments="x:String" Name="ScenarioID" />
                              <Variable x:TypeArguments="x:String" Name="ScenarioName" />
                              <Variable x:TypeArguments="x:String" Name="Operation" />
                              <Variable x:TypeArguments="x:String" Name="CorrelatesWithScenarioID" />
                              <Variable x:TypeArguments="x:String" Name="InputData" />
                              <Variable x:TypeArguments="x:String" Name="TargetRecipient" />
                              <Variable x:TypeArguments="x:String" Name="AttachmentSourcePath" />
                              <Variable x:TypeArguments="x:Int32" Name="ScenarioTimeoutSec" />
                              <Variable x:TypeArguments="x:Int32" Name="PollIntervalSec" />
                              <Variable x:TypeArguments="x:Int32" Name="RetryCount" />
                              <Variable x:TypeArguments="x:String" Name="RetryOnTimeoutOnly" />
                              <Variable x:TypeArguments="x:String" Name="Token" />
                              <Variable x:TypeArguments="x:Boolean" Name="Found" Default="False" />
                              <Variable x:TypeArguments="x:String" Name="MatchedSubject" Default="&quot;&quot;" />
                              <Variable x:TypeArguments="x:Int32" Name="RetriesLeft" />
                              <Variable x:TypeArguments="x:String" Name="ExpectedToken" Default="&quot;&quot;" />
                            </Sequence.Variables>
                            <Assign DisplayName="Assign scenario fields">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">ScenarioID</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["ScenarioID"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign ScenarioName">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">ScenarioName</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["ScenarioName"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign Operation">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">Operation</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["Operation"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign CorrelatesWithScenarioID">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">CorrelatesWithScenarioID</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["CorrelatesWithScenarioID"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign InputData">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">InputData</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["InputData"].ToString()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign TargetRecipient">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">TargetRecipient</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["TargetRecipient"].ToString().Trim().ToLower() == "self" ? NotifyEmail : ScenarioRow["TargetRecipient"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign AttachmentSourcePath">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">AttachmentSourcePath</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["AttachmentSourcePath"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign ScenarioTimeoutSec">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">
                                  <CSharpReference x:TypeArguments="x:Int32">ScenarioTimeoutSec</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">
                                  <CSharpValue x:TypeArguments="x:Int32">Int32.Parse(ScenarioRow["TimeoutSec"].ToString())</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign PollIntervalSec">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">
                                  <CSharpReference x:TypeArguments="x:Int32">PollIntervalSec</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">
                                  <CSharpValue x:TypeArguments="x:Int32">string.IsNullOrWhiteSpace(ScenarioRow["PollIntervalSec"].ToString()) ? 10 : Int32.Parse(ScenarioRow["PollIntervalSec"].ToString())</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign RetryCount">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">
                                  <CSharpReference x:TypeArguments="x:Int32">RetryCount</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">
                                  <CSharpValue x:TypeArguments="x:Int32">string.IsNullOrWhiteSpace(ScenarioRow["RetryCount"].ToString()) ? 0 : Int32.Parse(ScenarioRow["RetryCount"].ToString())</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <Assign DisplayName="Assign RetryOnTimeoutOnly">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">
                                  <CSharpReference x:TypeArguments="x:String">RetryOnTimeoutOnly</CSharpReference>
                                </OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">
                                  <CSharpValue x:TypeArguments="x:String">ScenarioRow["RetryOnTimeoutOnly"].ToString().Trim()</CSharpValue>
                                </InArgument>
                              </Assign.Value>
                            </Assign>
                            <TryCatch DisplayName="Try this scenario">
                              <TryCatch.Try>
                                <Sequence DisplayName="Try">
                                  <Switch x:TypeArguments="x:String" DisplayName="Switch on Operation" Expression="Operation">
                                    <Sequence x:Key="SendEmail" DisplayName="SendEmail">
                                      <Assign DisplayName="Assign Token">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:String">
                                            <CSharpReference x:TypeArguments="x:String">Token</CSharpReference>
                                          </OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:String">
                                            <CSharpValue x:TypeArguments="x:String">"HC-" + RunID + "-" + AppID + "-" + ScenarioID + "-" + DateTime.Now.ToString("yyyyMMddHHmmss")</CSharpValue>
                                          </InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <Assign DisplayName="Store token by ScenarioID">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="x:String">
                                            <CSharpReference x:TypeArguments="x:String">ScenarioTokens[ScenarioID]</CSharpReference>
                                          </OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="x:String">
                                            <CSharpValue x:TypeArguments="x:String">Token</CSharpValue>
                                          </InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <Assign DisplayName="Store scenario row by ScenarioID">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="sd:DataRow">
                                            <CSharpReference x:TypeArguments="sd:DataRow">SendRowsByScenarioID[ScenarioID]</CSharpReference>
                                          </OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="sd:DataRow">
                                            <CSharpValue x:TypeArguments="sd:DataRow">ScenarioRow</CSharpValue>
                                          </InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <If DisplayName="If no attachment">
                                        <If.Condition>
                                          <InArgument x:TypeArguments="x:Boolean">
                                            <CSharpValue x:TypeArguments="x:Boolean">string.IsNullOrWhiteSpace(AttachmentSourcePath)</CSharpValue>
                                          </InArgument>
                                        </If.Condition>
                                        <If.Then>
                                          <Sequence DisplayName="Then">
