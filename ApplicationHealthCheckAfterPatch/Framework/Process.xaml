      <Variable x:TypeArguments="sd:DataTable" Name="ScenarioResults" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="ScenarioTokens" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, sd:DataRow)" Name="SendRowsByScenarioID" />
      <Variable x:TypeArguments="x:String" Name="AppStatus" Default="&quot;PASS&quot;" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtScenarios" />
      <Variable x:TypeArguments="x:Boolean" Name="AppLaunched" Default="False" />
      <Variable x:TypeArguments="sd:DataTable" Name="AppResultsTable" />
    </Sequence.Variables>
