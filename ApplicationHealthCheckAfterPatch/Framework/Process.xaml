                  </Assign.Value>
                </Assign>
              </Sequence>
            </Switch.Default>
          </Switch>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch">
              <ui:LogMessage DisplayName="Log Message (app health check failed)" Level="Fatal">
                <ui:LogMessage.Message>
                  <InArgument x:TypeArguments="x:Object">
                    <CSharpValue x:TypeArguments="x:Object">"Health check failed for " + AppName + " (" + AppID + "): " + exception.Message</CSharpValue>
                  </InArgument>
                </ui:LogMessage.Message>
              </ui:LogMessage>
              <Assign DisplayName="Assign AppStatus (FAIL, app exception)">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">
                    <CSharpReference x:TypeArguments="x:String">AppStatus</CSharpReference>
                  </OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">
                    <CSharpValue x:TypeArguments="x:String">"FAIL"</CSharpValue>
                  </InArgument>
                </Assign.Value>
              </Assign>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
      <TryCatch.Finally>
        <Sequence DisplayName="Finally">
          <Sequence.Variables>
            <Variable x:TypeArguments="x:String" Name="HtmlBody" />
          </Sequence.Variables>
          <TryCatch DisplayName="Try close/cleanup app">
            <TryCatch.Try>
              <Sequence DisplayName="Try">
                <If DisplayName="If Outlook was launched">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">
                      <CSharpValue x:TypeArguments="x:Boolean">AppLaunched &amp;&amp; AppName == "Outlook"</CSharpValue>
                    </InArgument>
                  </If.Condition>
                  <If.Then>
                    <Sequence DisplayName="Then">
                      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Outlook_Close workflow" UnSafe="False" WorkflowFileName="Applications\Outlook\Outlook_Close.xaml">
                        <ui:InvokeWorkflowFile.Arguments>
                          <scg:Dictionary x:TypeArguments="x:String, Argument">
                            <InArgument x:TypeArguments="x:Int32" x:Key="in_TimeoutSec">
                              <CSharpValue x:TypeArguments="x:Int32">TimeoutSec</CSharpValue>
                            </InArgument>
                          </scg:Dictionary>
                        </ui:InvokeWorkflowFile.Arguments>
                      </ui:InvokeWorkflowFile>
                      <If DisplayName="If CleanupMode is Delete">
                        <If.Condition>
                          <InArgument x:TypeArguments="x:Boolean">
                            <CSharpValue x:TypeArguments="x:Boolean">CleanupMode.Trim().ToUpper() == "DELETE"</CSharpValue>
                          </InArgument>
                        </If.Condition>
                        <If.Then>
                          <Sequence DisplayName="Then">
                            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke Outlook_Cleanup workflow" UnSafe="False" WorkflowFileName="Applications\Outlook\Outlook_Cleanup.xaml">
                              <ui:InvokeWorkflowFile.Arguments>
                                <scg:Dictionary x:TypeArguments="x:String, Argument" />
                              </ui:InvokeWorkflowFile.Arguments>
                            </ui:InvokeWorkflowFile>
                          </Sequence>
                        </If.Then>
                      </If>
                    </Sequence>
                  </If.Then>
                </If>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Catch">
                    <ui:LogMessage DisplayName="Log Message (close/cleanup failed)" Level="Warn">
                      <ui:LogMessage.Message>
                        <InArgument x:TypeArguments="x:Object">
                          <CSharpValue x:TypeArguments="x:Object">"Close/cleanup failed for " + AppName + ": " + exception.Message</CSharpValue>
                        </InArgument>
                      </ui:LogMessage.Message>
                    </ui:LogMessage>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
          <TryCatch DisplayName="Try build and send holistic report">
            <TryCatch.Try>
              <Sequence DisplayName="Try">
                <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke BuildHtmlReport workflow" UnSafe="False" WorkflowFileName="Reporting\BuildHtmlReport.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <scg:Dictionary x:TypeArguments="x:String, Argument">
                      <InArgument x:TypeArguments="x:String" x:Key="in_AppID">
                        <CSharpValue x:TypeArguments="x:String">AppID</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_AppName">
                        <CSharpValue x:TypeArguments="x:String">AppName</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_AppStatus">
                        <CSharpValue x:TypeArguments="x:String">AppStatus</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_RunID">
                        <CSharpValue x:TypeArguments="x:String">RunID</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="sd:DataTable" x:Key="in_ScenarioResults">
                        <CSharpValue x:TypeArguments="sd:DataTable">ScenarioResults</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_TemplatePath">
                        <CSharpValue x:TypeArguments="x:String">"Templates\\HolisticReportTemplate.html"</CSharpValue>
                      </InArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_HtmlBody">
                        <CSharpReference x:TypeArguments="x:String">HtmlBody</CSharpReference>
                      </OutArgument>
                    </scg:Dictionary>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke SaveReportLocal workflow" UnSafe="False" WorkflowFileName="Reporting\SaveReportLocal.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <scg:Dictionary x:TypeArguments="x:String, Argument">
                      <InArgument x:TypeArguments="x:String" x:Key="in_HtmlBody">
                        <CSharpValue x:TypeArguments="x:String">HtmlBody</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_FilePath">
                        <CSharpValue x:TypeArguments="x:String">Path.Combine(ReportsFolder, AppID + "_HolisticSummary.html")</CSharpValue>
                      </InArgument>
                    </scg:Dictionary>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
                <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke EmailReport workflow" UnSafe="False" WorkflowFileName="Reporting\EmailReport.xaml">
                  <ui:InvokeWorkflowFile.Arguments>
                    <scg:Dictionary x:TypeArguments="x:String, Argument">
                      <InArgument x:TypeArguments="x:String" x:Key="in_ToAddress">
                        <CSharpValue x:TypeArguments="x:String">NotifyEmail</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_Subject">
                        <CSharpValue x:TypeArguments="x:String">"Health Check - " + AppName + " - " + AppStatus</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="in_HtmlBody">
                        <CSharpValue x:TypeArguments="x:String">HtmlBody</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="x:Int32" x:Key="in_TimeoutSec">
                        <CSharpValue x:TypeArguments="x:Int32">TimeoutSec</CSharpValue>
                      </InArgument>
                    </scg:Dictionary>
                  </ui:InvokeWorkflowFile.Arguments>
                </ui:InvokeWorkflowFile>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Catch">
                    <ui:LogMessage DisplayName="Log Message (report build/send failed)" Level="Warn">
                      <ui:LogMessage.Message>
                        <InArgument x:TypeArguments="x:Object">
                          <CSharpValue x:TypeArguments="x:Object">"Holistic report build/send failed for " + AppName + ": " + exception.Message</CSharpValue>
                        </InArgument>
                      </ui:LogMessage.Message>
                    </ui:LogMessage>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
          <TryCatch DisplayName="Try record run history and master results">
            <TryCatch.Try>
              <Sequence DisplayName="Try">
                <ui:AppendLine DisplayName="Append Line (RunHistory.jsonl)" Encoding="{x:Null}" FileName="Data\History\RunHistory.jsonl">
                  <ui:AppendLine.Text>
                    <InArgument x:TypeArguments="x:String">
                      <CSharpValue x:TypeArguments="x:String">"{\"RunID\":\"" + RunID + "\",\"AppID\":\"" + AppID + "\",\"AppName\":\"" + AppName + "\",\"Status\":\"" + AppStatus + "\",\"ScenarioCount\":" + ScenarioResults.Rows.Count + ",\"PassCount\":" + ScenarioResults.AsEnumerable().Count(r =&gt; r.Field&lt;string&gt;("Status") == "Pass") + ",\"FailCount\":" + ScenarioResults.AsEnumerable().Count(r =&gt; r.Field&lt;string&gt;("Status") == "Fail") + ",\"Timestamp\":\"" + DateTime.Now.ToString("o") + "\"}"</CSharpValue>
                    </InArgument>
                  </ui:AppendLine.Text>
                </ui:AppendLine>
                <If DisplayName="If MasterAppResults table does not exist yet">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">
                      <CSharpValue x:TypeArguments="x:Boolean">!in_Config.ContainsKey("MasterAppResults")</CSharpValue>
                    </InArgument>
                  </If.Condition>
                  <If.Then>
                    <Sequence DisplayName="Then">
                      <uic:GenerateDataTable DisplayName="Generate Data Table (MasterAppResults header)" AutoDetectTypes="True" UseColumnHeader="True" CSVParsing="True">
                        <uic:GenerateDataTable.Input>
                          <InArgument x:TypeArguments="x:String">
                            <CSharpValue x:TypeArguments="x:String">"AppID,AppName,Status,PassCount,FailCount,ScenarioCount"</CSharpValue>
                          </InArgument>
                        </uic:GenerateDataTable.Input>
                        <uic:GenerateDataTable.DataTable>
                          <OutArgument x:TypeArguments="sd:DataTable">
                            <CSharpReference x:TypeArguments="sd:DataTable">AppResultsTable</CSharpReference>
                          </OutArgument>
                        </uic:GenerateDataTable.DataTable>
                      </uic:GenerateDataTable>
                      <Assign DisplayName="Assign in_Config MasterAppResults">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Object">
                            <CSharpReference x:TypeArguments="x:Object">in_Config["MasterAppResults"]</CSharpReference>
                          </OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Object">
                            <CSharpValue x:TypeArguments="x:Object">AppResultsTable</CSharpValue>
                          </InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence DisplayName="Else">
                      <Assign DisplayName="Assign AppResultsTable (existing)">
                        <Assign.To>
                          <OutArgument x:TypeArguments="sd:DataTable">
                            <CSharpReference x:TypeArguments="sd:DataTable">AppResultsTable</CSharpReference>
                          </OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="sd:DataTable">
                            <CSharpValue x:TypeArguments="sd:DataTable">(DataTable)in_Config["MasterAppResults"]</CSharpValue>
                          </InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
                <uic:AddDataRow DisplayName="Add Data Row (MasterAppResults)">
                  <uic:AddDataRow.DataTable>
                    <InOutArgument x:TypeArguments="sd:DataTable">
                      <CSharpReference x:TypeArguments="sd:DataTable">AppResultsTable</CSharpReference>
                    </InOutArgument>
                  </uic:AddDataRow.DataTable>
                  <uic:AddDataRow.ArrayRow>
                    <InArgument x:TypeArguments="s:Object[]">
                      <CSharpValue x:TypeArguments="s:Object[]">new object[] {AppID, AppName, AppStatus, ScenarioResults.AsEnumerable().Count(r =&gt; r.Field&lt;string&gt;("Status") == "Pass"), ScenarioResults.AsEnumerable().Count(r =&gt; r.Field&lt;string&gt;("Status") == "Fail"), ScenarioResults.Rows.Count }</CSharpValue>
                    </InArgument>
                  </uic:AddDataRow.ArrayRow>
                </uic:AddDataRow>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Catch">
                    <ui:LogMessage DisplayName="Log Message (history/master result recording failed)" Level="Warn">
                      <ui:LogMessage.Message>
                        <InArgument x:TypeArguments="x:Object">
                          <CSharpValue x:TypeArguments="x:Object">"Failed to record run history / master result for " + AppName + ": " + exception.Message</CSharpValue>
                        </InArgument>
                      </ui:LogMessage.Message>
                    </ui:LogMessage>
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
          <ui:LogMessage DisplayName="Log Message (app health check complete)" Level="Info">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">"Completed health check for " + AppName + " (" + AppID + ") — status: " + AppStatus</CSharpValue>
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </TryCatch.Finally>
    </TryCatch>
  </Sequence>
</Activity>
