      <Variable x:TypeArguments="sd:DataRow" Name="AppRow" />
      <Variable x:TypeArguments="x:String" Name="AppID" />
      <Variable x:TypeArguments="x:String" Name="AppName" />
      <Variable x:TypeArguments="x:String" Name="ExePath" />
      <Variable x:TypeArguments="x:String" Name="CleanupMode" />
      <Variable x:TypeArguments="x:String" Name="NotifyEmail" />
