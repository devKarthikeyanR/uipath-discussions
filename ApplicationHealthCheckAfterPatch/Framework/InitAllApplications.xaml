      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Load the Health Check config workbooks' GlobalConfig sheet (Config.xlsx) into Config, create the dated run folder (Configs/Evidence/Reports), and snapshot both Config.xlsx and Applications.xlsx into it." DisplayName="Initialize All Applications">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_GlobalConfig" />
      <Variable x:TypeArguments="x:String" Name="RunID" />
      <Variable x:TypeArguments="x:String" Name="RunFolder" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log message (Initialize applications)" Level="Trace">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Loading Health Check app config and preparing run folder..."</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <Assign DisplayName="Assign GlobalConfigWorkbook (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["GlobalConfigWorkbook"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Config\\Config.xlsx"</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign AppConfigWorkbook (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["AppConfigWorkbook"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Config\\Applications.xlsx"</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DisplayName="Read range (GlobalConfig sheet)" SheetName="GlobalConfig">
      <ui:ReadRange.DataTable>
        <OutArgument x:TypeArguments="sd:DataTable">
          <CSharpReference x:TypeArguments="sd:DataTable">dt_GlobalConfig</CSharpReference>
        </OutArgument>
      </ui:ReadRange.DataTable>
      <ui:ReadRange.WorkbookPath>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">in_Config["GlobalConfigWorkbook"].ToString()</CSharpValue>
        </InArgument>
      </ui:ReadRange.WorkbookPath>
    </ui:ReadRange>
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DisplayName="For each GlobalConfig row">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="Row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <If DisplayName="If GlobalConfig row is not empty">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">
                  <CSharpValue x:TypeArguments="x:Boolean">!string.IsNullOrWhiteSpace(Row["Key"].ToString().Trim())</CSharpValue>
                </InArgument>
              </If.Condition>
              <If.Then>
                <Sequence DisplayName="Then">
                  <Assign DisplayName="Add GlobalConfig key/value pair">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Object">
                        <CSharpReference x:TypeArguments="x:Object">in_Config[Row["Key"].ToString().Trim()]</CSharpReference>
                      </OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Object">
                        <CSharpValue x:TypeArguments="x:Object">Row["Value"]</CSharpValue>
                      </InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
      <ui:ForEachRow.DataTable>
        <InArgument x:TypeArguments="sd:DataTable">
          <CSharpValue x:TypeArguments="sd:DataTable">dt_GlobalConfig</CSharpValue>
        </InArgument>
      </ui:ForEachRow.DataTable>
    </ui:ForEachRow>
    <Assign DisplayName="Assign RunID">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">RunID</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">DateTime.Now.ToString("HHmmss")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign RunFolder">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">RunFolder</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(in_Config["RunFolderRoot"].ToString(), DateTime.Now.ToString("yyyyMMdd"), "Run_" + RunID)</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:CreateDirectory DisplayName="Create Folder (Configs)">
      <ui:CreateDirectory.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(RunFolder, "Configs")</CSharpValue>
        </InArgument>
      </ui:CreateDirectory.Path>
    </ui:CreateDirectory>
    <ui:CreateDirectory DisplayName="Create Folder (Evidence)">
      <ui:CreateDirectory.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(RunFolder, "Evidence")</CSharpValue>
        </InArgument>
      </ui:CreateDirectory.Path>
    </ui:CreateDirectory>
    <ui:CreateDirectory DisplayName="Create Folder (Reports)">
      <ui:CreateDirectory.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(RunFolder, "Reports")</CSharpValue>
        </InArgument>
      </ui:CreateDirectory.Path>
    </ui:CreateDirectory>
    <ui:CopyFile DisplayName="Copy File (snapshot Config.xlsx)" Overwrite="True">
      <ui:CopyFile.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">in_Config["GlobalConfigWorkbook"].ToString()</CSharpValue>
        </InArgument>
      </ui:CopyFile.Path>
      <ui:CopyFile.Destination>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(RunFolder, "Configs")</CSharpValue>
        </InArgument>
      </ui:CopyFile.Destination>
    </ui:CopyFile>
    <ui:CopyFile DisplayName="Copy File (snapshot Applications.xlsx)" Overwrite="True">
      <ui:CopyFile.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">in_Config["AppConfigWorkbook"].ToString()</CSharpValue>
        </InArgument>
      </ui:CopyFile.Path>
      <ui:CopyFile.Destination>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">Path.Combine(RunFolder, "Configs")</CSharpValue>
        </InArgument>
      </ui:CopyFile.Destination>
    </ui:CopyFile>
    <Assign DisplayName="Assign RunID (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["RunID"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">RunID</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign RunFolder (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["RunFolder"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">RunFolder</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign ConfigsFolder (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["ConfigsFolder"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">Path.Combine(RunFolder, "Configs")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign EvidenceFolder (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["EvidenceFolder"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">Path.Combine(RunFolder, "Evidence")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign ReportsFolder (Config key)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">
          <CSharpReference x:TypeArguments="x:Object">in_Config["ReportsFolder"]</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">Path.Combine(RunFolder, "Reports")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log message (run folder ready)" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Run folder ready: " + RunFolder</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>